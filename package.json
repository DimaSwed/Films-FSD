{
  "name": "kinotracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fsd": "steiger ./src",
    "lint:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.app.json src",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc -b",
    "start": "vite",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.29.14",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/ubuntu": "^5.3.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-query-devtools": "^5.108.1",
    "axios": "^1.21.1",
    "js-cookie": "^3.0.8",
    "notistack": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^5.0.0",
    "react-router-dom": "^7.18.6",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@conarti/eslint-plugin-feature-sliced": "^2.0.1",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@tanstack/eslint-plugin-query": "^5.108.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "madge": "^8.0.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "steiger": "^0.7.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-sass-dts": "1.3.31",
    "vite-tsconfig-paths": "^5.1.4",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@9.5.0"
}
